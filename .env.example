# ============================================
# Jacob Tech Info - Environment Variables
# ============================================

# Base URL (required for SEO and sitemap)
NEXT_PUBLIC_BASE_URL=https://jacobtechinfo.com

# ============================================
# Database (Turso)
# ============================================
# Option 1: Using Turso (Recommended for production)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Option 2: Using SQLite locally (Development)
# DATABASE_URL="file:./dev.db"

# ============================================
# Authentication (NextAuth.js v5)
# ============================================
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-key-min-32-characters-long

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_ID=your-google-oauth-client-id
GOOGLE_SECRET=your-google-oauth-client-secret

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

# ============================================
# Firebase Storage (for images)
# ============================================
# Get these from Firebase Console > Project Settings
FIREBASE=your-firebase-api-key

# ============================================
# Optional: Analytics & Monitoring
# ============================================
# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ============================================
# Security Headers (optional)
# ============================================
# CSP Nonce for strict CSP (advanced)
# CSP_NONCE_SECRET=your-nonce-secret
